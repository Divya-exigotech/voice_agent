ENVIRONMENT=local
DATABASE_URL=postgresql://user:password@host:5432/calling_agnet
CORS_ORIGINS=["http://localhost:5173"]

# Azure AI Foundry voice agent (leave blank here; set real values only in backend/.env)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=
AZURE_AI_USE_STRUCTURED_INPUTS=false
# Ask the agent to speak first when a voice session opens
AZURE_AI_REQUEST_GREETING=true
VOICE_SESSION_MAX_SECONDS=600

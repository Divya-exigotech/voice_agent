# Copy to `.env` (backend) — never commit real values.

# --- Backend (FastAPI) -------------------------------------------------------
# Single customer/invoice JSON file. Relative paths resolve from the repo root.
CUSTOMERS_JSON_PATH=data/customers.json

# --- Existing Microsoft Foundry voice agent (M2+) ----------------------------
# The agent's model, instructions, voice and tools are configured in Foundry.
# Auth is Microsoft Entra ID only. No API key is used.
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_AGENT_NAME=
AZURE_AI_AGENT_TIMEOUT_SECONDS=45

# How the backend signs in to Azure (the identity needs "Azure AI User" on the project):
#   default       - DefaultAzureCredential: `az login`, `azd auth login`, managed identity
#   browser       - no Azure CLI needed: a browser window opens on the first call; the
#                   sign-in is cached (encrypted) so restarts don't ask again
#   client_secret - service principal: set AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
AZURE_AUTH_METHOD=default
# Optional with browser (use it if your account belongs to several tenants).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Dashboard sign-in (Microsoft Entra ID) ----------------------------------
# Uses the app registration above (AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET).
# Register this exact URL as a Web redirect URI on the app registration.
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# Where the browser lands after signing in (the frontend).
APP_BASE_URL=http://localhost:3000

# Browser origins allowed to open the voice WebSocket (JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Agent behaviour -----------------------------------------------------------
AGENT_ORGANIZATION_NAME=the accounts team
# Used to resolve "today" when validating promised payment dates
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Azure Blob Storage: transcripts (M4) ---------------------------------------
# Entra ID auth (DefaultAzureCredential / managed identity); no account keys or SAS.
# Needs "Storage Blob Data Contributor" on the account or container.
# When unset, transcripts are kept in memory only (development).
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# Private container; create/verify with: python -m scripts.setup_blob
AZURE_STORAGE_CONTAINER=call-transcripts

# --- Existing PostgreSQL database ----------------------------------------------
# When DATABASE_URL is set it replaces CUSTOMERS_JSON_PATH: the queue is read from
# call_tasks/clients/invoices and sessions, outcomes and transcript turns are written
# to calls/call_events/call_actions/call_transcripts/audit_logs. No DDL is ever run.
# Leave unset to use the JSON file. Put the real value (with password) in .env only.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# Required with DATABASE_URL: organizations.id that every query is scoped to.
# DATABASE_ORGANIZATION_ID=
# DATABASE_SCHEMA=public
# Optional agents.id recorded on calls.agent_id.
# DATABASE_AGENT_ID=
# invoices has no currency column: organizations.settings->>'currency', else this.
# DATABASE_DEFAULT_CURRENCY=INR
# DATABASE_DEFAULT_LANGUAGE=English
# invoices.status values that mean money is owed -> unpaid | partially_paid | overdue
# DATABASE_INVOICE_STATUS_MAP={"pending":"unpaid","overdue":"overdue","partially_paid":"partially_paid"}
# Status values written to call_tasks.status and calls.status. They MUST match the
# values used by the application that owns the schema.
# DATABASE_TASK_STATUS_QUEUED=queued
# DATABASE_TASK_STATUS_IN_PROGRESS=in_progress
# DATABASE_TASK_STATUS_COMPLETED=completed
# DATABASE_CALL_STATUS_IN_PROGRESS=initiated
# DATABASE_CALL_STATUS_COMPLETED=completed
# DATABASE_CALL_STATUS_DECLINED=declined
# DATABASE_CALL_STATUS_FAILED=failed

# --- Frontend (Next.js) ------------------------------------------------------
# Put these in frontend/.env.local.
# Server-side only: Next.js proxies /api/* (REST) here.
BACKEND_URL=http://localhost:8000
# Public (no secret): where the browser opens the voice WebSocket. Defaults to
# ws://<page hostname>:8000. Use wss:// when the app is served over https.
# NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000
